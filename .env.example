# ── 数据库 ─────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/fastapi_demo

# ── JWT ────────────────────────────────────────────────────
# 生成方式：python -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET_KEY=replace-me-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── 应用环境 ───────────────────────────────────────────────
APP_ENV=development
DEBUG=False
